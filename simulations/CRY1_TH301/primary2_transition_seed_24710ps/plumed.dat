UNITS LENGTH=A TIME=ps

# W399 chi1 = N-CA-CB-CG, chi2 = CA-CB-CG-CD1
chi1: TORSION ATOMS=6106,6108,6110,6113
chi2: TORSION ATOMS=6108,6110,6113,6114

# Well-Tempered Metadynamics
METAD ...
  ARG=chi1,chi2
  SIGMA=0.3,0.3
  HEIGHT=0.01
  PACE=500
  BIASFACTOR=10
  TEMP=300
  FILE=HILLS_WTMD_02
... METAD

# ?�� COLVAR ?��
PRINT ARG=chi1,chi2 FILE=COLVAR_WTMD_02 STRIDE=500
