UNITS LENGTH=A TIME=ps

# ��? ��1 �� ��2 �����
chi1: TORSION ATOMS=6384,6386,6388,6391
chi2: TORSION ATOMS=6386,6388,6391,6392

# Well-Tempered Metadynamics
METAD ...
  ARG=chi1,chi2
  SIGMA=0.3,0.3
  GRID_MIN=-pi,-pi
  GRID_MAX=pi,pi
  GRID_BIN=600,600
  HEIGHT=0.01
  PACE=500
  BIASFACTOR=10
  TEMP=300
  FILE=HILLS_seed_apo_unbiased_out_201820ps
... METAD

# ?�� COLVAR ?��
PRINT ARG=chi1,chi2 FILE=COLVAR_seed_apo_unbiased_out_201820ps STRIDE=500
