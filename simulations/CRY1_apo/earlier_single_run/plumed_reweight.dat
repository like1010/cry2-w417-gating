UNITS LENGTH=A TIME=ps

# W399 chi1 = N-CA-CB-CG, chi2 = CA-CB-CG-CD1
  chi1: TORSION ATOMS=6093,6095,6097,6100
  chi2: TORSION ATOMS=6095,6097,6100,6101

# Well-Tempered Metadynamics ��ʥ??��
METAD ...
  LABEL=metad
  ARG=chi1,chi2
  SIGMA=0.3,0.3
  HEIGHT=0.0
  PACE=10000000
  BIASFACTOR=10
  TEMP=300
  FILE=HILLS_CRY1_apo
  RESTART=YES
... METAD

# ?������?�� chi1, chi2, metad.bias
PRINT ARG=chi1,chi2,metad.bias FILE=COLVAR_CRY1_apo_REWEIGHT STRIDE=1
