UNITS LENGTH=A TIME=ps

# W399 chi1 = N-CA-CB-CG, chi2 = CA-CB-CG-CD1
  chi1: TORSION ATOMS=6093,6095,6097,6100
  chi2: TORSION ATOMS=6095,6097,6100,6101

# Well-Tempered Metadynamics
METAD ...
  ARG=chi1,chi2
  SIGMA=0.3,0.3
  HEIGHT=0.01
  PACE=500
  BIASFACTOR=10
  TEMP=300
  FILE=HILLS_CRY1_apo
... METAD

# ?�� COLVAR ?��
PRINT ARG=chi1,chi2 FILE=COLVAR_CRY1_apo STRIDE=500
