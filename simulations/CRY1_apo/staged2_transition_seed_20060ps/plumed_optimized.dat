# Optimized continuation: periodic grid; original physics and hill schedule preserved.
RESTART
# CRY1 W399 chi1 N-CA-CB-CG; chi2 CA-CB-CG-CD1
UNITS LENGTH=A TIME=ps

chi1: TORSION ATOMS=6376,6378,6380,6383
chi2: TORSION ATOMS=6378,6380,6383,6384

METAD ...
  ARG=chi1,chi2
  SIGMA=0.3,0.3
  HEIGHT=0.01
  PACE=500
  BIASFACTOR=10
  TEMP=300
  FILE=HILLS_CRY1_apo_transition_500ns
  GRID_MIN=-pi,-pi
  GRID_MAX=pi,pi
  GRID_BIN=384,384
... METAD

PRINT ARG=chi1,chi2 FILE=COLVAR_CRY1_apo_transition_500ns STRIDE=500
