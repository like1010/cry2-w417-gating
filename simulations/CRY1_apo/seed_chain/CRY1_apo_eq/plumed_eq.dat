UNITS LENGTH=A TIME=ps

# W399 chi1 = N-CA-CB-CG, chi2 = CA-CB-CG-CD1
chi1: TORSION ATOMS=6376,6378,6380,6383
chi2: TORSION ATOMS=6378,6380,6383,6384

# ͳ   chi2   0.33 rad ݾ Σ      Equilibration
RESTRAINT ...
  ARG=chi2
  AT=0.901075047
  KAPPA=500.0
... RESTRAINT

# ?   chi1    chi2       ?  
PRINT ARG=chi1,chi2 FILE=COLVAR_equil STRIDE=5000
